<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    1ES Network Isolation (CFS): restore NuGet packages (packages.config, restored by the
    gulp 'nuget_restore' task) exclusively from the CFS-backed CLE_PublicPackages Azure
    Artifacts feed instead of the public api.nuget.org. The feed proxies the public
    packages this project consumes via its upstream source. Credentials are provided in CI
    by the NuGetAuthenticate task.
  -->
  <packageSources>
    <clear />
    <add key="CLE_PublicPackages" value="https://pkgs.dev.azure.com/Office/CLE/_packaging/CLE_PublicPackages/nuget/v3/index.json" />
  </packageSources>
  <disabledPackageSources>
    <clear />
  </disabledPackageSources>
</configuration>
